{
  "title": "TP-Link WPA Powerline",
  "config": {
    "step": {
      "user": {
        "title": "Set up TP-Link WPA Powerline",
        "description": "Enter the connection details for your TP-Link WPA powerline device.",
        "data": {
          "ip_address": "IP address",
          "password": "Password"
        }
      }
    },
    "error": {
      "cannot_connect": "Cannot connect to the device",
      "unknown": "Unexpected error"
    },
    "abort": {
      "already_configured": "This device is already configured"
    }
  },
  "options": {
