        "name": "PLC below 100 Mbit/s"
      },
      "wifi_24_enabled": {
        "name": "Wi-Fi 2.4 GHz enabled"
      },
      "wifi_5_enabled": {
        "name": "Wi-Fi 5 GHz enabled"
