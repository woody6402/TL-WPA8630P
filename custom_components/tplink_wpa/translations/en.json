      "plc_peers": {
        "name": "PLC peers"
      },
      "plc_max_rx": {
        "name": "PLC max RX"
      },
      "plc_max_tx": {
        "name": "PLC max TX"
      },
      "plc_min_rx": {
        "name": "PLC min RX"
      },
      "plc_min_tx": {
        "name": "PLC min TX"
      },
      "wifi_ssid_24": {
        "name": "SSID 2.4 GHz"
      },
      "wifi_ssid_5": {
        "name": "SSID 5 GHz"
